# 1. 忽略依赖包
node_modules/

# 2. 忽略构建产物
dist/
build/

# 3. 忽略环境变量（保护密钥安全）
.env
.env.*

# 4. 数据库文件（含用户数据，绝对不能提交）
*.db
*.db-journal
*.db-wal

# 5. 编译生成的 JS 文件（TS 源码才是真源）
*vite.config.js

# 6. Prisma 生成的文件
/generated/prisma

# 7. 临时打包 / 备份文件
*.tar.gz
*.zip
*.7z

# 8. 系统和编辑器文件
.DS_Store
.vscode/
*.log

# 9. 上传文件目录
uploads/
