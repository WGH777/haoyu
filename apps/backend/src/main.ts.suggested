// apps/backend/src/main.ts.suggested
// 改动说明：将硬编码的 CORS origin 改为 CORS_ORIGIN 环境变量
//
// 原始行 17-19:
//   app.enableCors({
//     origin: ['http://localhost:5173', 'http://www.haoyulv.com', 'https://www.haoyulv.com'],
//     credentials: true,
//   });
//
// 替换为:

const corsOrigins = (process.env.CORS_ORIGIN || 'http://localhost:5173')
  .split(',')
  .map(s => s.trim())
  .filter(Boolean)

app.enableCors({
  origin: corsOrigins,
  credentials: true,
})

