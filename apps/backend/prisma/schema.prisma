// apps/backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==============================================================
//  移除 ENUM 定义，使用 STRING 代替，以兼容 SQLite
// ==============================================================

model User {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  password       String
  nickname       String
  bio            String?
  role           String        @default("USER")
  verified       Boolean       @default(false)
  certLevel      String        @default("NONE")
  isBanned       Boolean       @default(false)
  bannedAt       DateTime?
  banReason      String?
  refreshToken   String?

  avatar         String?                       // 用户头像 URL
  walletCount    Int?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  publishedTasks Task[]        @relation("UserPublishedTasks")
  orders         Order[]
  transactions   Transaction[]
  wallets        Wallet[]
  notifications  Notification[]

  // ✅ 新增：管理员审计日志（一个管理员可产生多条日志）
  adminActionLogs AdminActionLog[] @relation("AdminActionLogs")
}

model Wallet {
  id            String        @id @default(cuid())
  ownerType     String        @default("USER") // USER | SYSTEM
  userId        Int?                                 // null for system wallets
  user          User?         @relation(fields: [userId], references: [id])
  code          String?       @unique               // system wallet codes
  currency      String        @default("CNY")      // CNY | USD | EUR
  available     Int           @default(0)           // 可用余额，单位：分
  frozen        Int           @default(0)           // 冻结余额，单位：分
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([userId])
  @@unique([userId, currency])
}

model LedgerEntry {
  id              String   @id @default(cuid())
  walletId        String
  wallet          Wallet   @relation(fields: [walletId], references: [id])
  userId          Int?
  orderId         Int?
  order           Order?   @relation(fields: [orderId], references: [id])
  idempotencyKey  String?  @unique               // 幂等键：orderId+操作类型，防重复入账
  amount          Int                              // 变动金额，单位：分
  direction       String                           // IN | OUT
  type            String                           // DEPOSIT|FREEZE|UNFREEZE|SETTLEMENT|PLATFORM_FEE|REFUND|WITHDRAW|ADMIN_ADJUST|RISK_RESERVE
  balanceAfter    Int?                             // 操作后可用余额，单位：分
  frozenAfter     Int?                             // 操作后冻结余额，单位：分
  remark          String?
  operatorId      Int?
  createdAt       DateTime @default(now())

  @@index([walletId])
  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model Task {
  id                 Int           @id @default(autoincrement())
  title              String
  description        String
  price              Int                               // 单位：分
  serviceFee         Int           @default(0)         // 单位：分
  category           String        @default("SKILL_SERVICE")
  serviceMode        String        @default("ONLINE")
  serviceLocation    String?
  isPublicWelfare    Boolean       @default(false)
  isFamilyCare       Boolean       @default(false)
  isProxyRequest     Boolean       @default(false)
  needVerification   Boolean       @default(false)
  riskLevel          String        @default("LOW")
  location           String?

  // 热度：浏览量（打开详情页自动 +1）
  views              Int           @default(0)

  // 任务状态：使用字符串，默认 PENDING
  status             String        @default("PENDING")

  image              String?                       // 任务配图 URL
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  publisherId        Int
  publisher          User          @relation("UserPublishedTasks", fields: [publisherId], references: [id])

  orders             Order[]
  subTasks           SubTask[]
  disputes           Dispute[]
}

// 新增：子任务模型，用于任务拆分
model SubTask {
  id        Int      @id @default(autoincrement())
  title     String
  isDone    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id])
}

model Order {
  id                Int           @id @default(autoincrement())

  // 订单状态：ASSIGNED / SUBMITTED / COMPLETED / CANCELLED / DISPUTED
  status            String        @default("ASSIGNED")

  submissionContent String?                       // 成果提交：文本/链接
  submissionImage   String?                       // 成果提交：图片 URL
  submittedAt       DateTime?                     // 成果提交时间
  warned48h         Boolean       @default(false) // 48h 预警是否已发送
  confirmRetries    Int           @default(0)     // 自动确认重试次数

  amount            Int?                          // 订单金额，单位：分

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  taskId            Int
  task              Task          @relation(fields: [taskId], references: [id])
  workerId          Int
  worker            User          @relation(fields: [workerId], references: [id])

  ledgerEntries     LedgerEntry[]
  disputes          Dispute[]
  comments          OrderComment[]
}

model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Int                              // 单位：分（Legacy 表，后续迁移到 LedgerEntry）
  type      String
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String
  type      String                           // REQUEST_RESPONDED|SERVICE_STARTED|SERVICE_SUBMITTED|SERVICE_COMPLETED|ORDER_DISPUTED|REFUND_CREATED|SETTLEMENT_CREATED|RISK_ALERT|SYSTEM|PAYMENT_RECEIVED|AUTO_CONFIRMED|ORDER_CANCELLED|DISPUTE_RESOLVED|DEADLINE_WARNING|PROVIDER_UNRESPONSIVE
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Dispute {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id])
  taskId      Int
  task        Task     @relation(fields: [taskId], references: [id])
  openerId    Int
  reason      String
  evidence    String?
  status      String   @default("OPEN")       // OPEN|UNDER_REVIEW|RESOLVED|REJECTED|CANCELLED
  result      String?                          // REFUND_BUYER|PAY_SELLER|PARTIAL_REFUND|CANCEL_ORDER
  handledById Int?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([orderId])
  @@index([openerId])
}

// ✅ 新增：管理员审计日志（RBAC 第 6 步）
model AdminActionLog {
  id         Int      @id @default(autoincrement())

  // action 建议使用固定值：FORCE_CANCEL_TASK / FORCE_COMPLETE_ORDER / FORCE_REJECT_ORDER 等
  action     String

  // targetType: TASK / ORDER / USER / TRANSACTION 等
  targetType String
  targetId   Int?

  reason     String?
  // 这里用 String 存 JSON，避免 sqlite/json 兼容坑
  detailJson String?

  createdAt  DateTime @default(now())

  adminId    Int
  admin      User     @relation("AdminActionLogs", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// 订单留言（发布者↔服务者沟通）
model OrderComment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  userId    Int
  content   String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}
