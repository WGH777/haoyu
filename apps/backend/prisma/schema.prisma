// apps/backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==============================================================
//  移除 ENUM 定义，使用 STRING 代替，以兼容 SQLite
// ==============================================================

model User {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  password       String
  nickname       String
  bio            String?
  role           String        @default("USER")
  balance        Float         @default(0)
  refreshToken   String?

  avatar         String?                       // 用户头像 URL

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  publishedTasks Task[]        @relation("UserPublishedTasks")
  orders         Order[]
  transactions   Transaction[]

  // ✅ 新增：管理员审计日志（一个管理员可产生多条日志）
  adminActionLogs AdminActionLog[] @relation("AdminActionLogs")
}

model Task {
  id            Int           @id @default(autoincrement())
  title         String
  description   String
  price         Float
  serviceFee    Float         @default(0)

  // 热度：浏览量（打开详情页自动 +1）
  views         Int           @default(0)

  // 任务状态：使用字符串，默认 PENDING
  status        String        @default("PENDING")

  image         String?                       // 任务配图 URL
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  publisherId   Int
  publisher     User          @relation("UserPublishedTasks", fields: [publisherId], references: [id])

  orders        Order[]
  subTasks      SubTask[]
}

// 新增：子任务模型，用于任务拆分
model SubTask {
  id        Int      @id @default(autoincrement())
  title     String
  isDone    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id])
}

model Order {
  id                Int           @id @default(autoincrement())

  // 订单状态：ASSIGNED / SUBMITTED / COMPLETED / CANCELLED
  status            String        @default("ASSIGNED")

  submissionContent String?                       // 成果提交：文本/链接
  submissionImage   String?                       // 成果提交：图片 URL
  submittedAt       DateTime?                     // 成果提交时间

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  taskId            Int
  task              Task          @relation(fields: [taskId], references: [id])
  workerId          Int
  worker            User          @relation(fields: [workerId], references: [id])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Float
  type      String
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

// ✅ 新增：管理员审计日志（RBAC 第 6 步）
model AdminActionLog {
  id         Int      @id @default(autoincrement())

  // action 建议使用固定值：FORCE_CANCEL_TASK / FORCE_COMPLETE_ORDER / FORCE_REJECT_ORDER 等
  action     String

  // targetType: TASK / ORDER / USER / TRANSACTION 等
  targetType String
  targetId   Int?

  reason     String?
  // 这里用 String 存 JSON，避免 sqlite/json 兼容坑
  detailJson String?

  createdAt  DateTime @default(now())

  adminId    Int
  admin      User     @relation("AdminActionLogs", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
