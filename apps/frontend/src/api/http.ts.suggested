// apps/frontend/src/api/http.ts.suggested
// 改动说明：将硬编码的 API_BASE 改为 VITE_API_BASE 环境变量
//
// 原始行 19-21:
//   const isDev = import.meta.env.DEV
//   export const API_BASE: string = isDev
//     ? 'http://localhost:3000/api'
//     : '/api'
//
// 替换为:

const VITE_API_BASE = import.meta.env.VITE_API_BASE || '/api'

export const API_BASE: string = VITE_API_BASE

// 优势：
// 1. 不再依赖 import.meta.env.DEV 判断环境
// 2. 开发时在 .env 设 VITE_API_BASE=http://localhost:3000/api
// 3. 生产时默认 /api（同域，无需修改）
// 4. 需要连其他后端时，只需改环境变量
