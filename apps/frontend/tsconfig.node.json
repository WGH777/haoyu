{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    
    // 🔥 核心修复：把 "ESNext" 改为 "Node16"
    // 这样就跟下面的 moduleResolution: "node16" 完美匹配了
    "module": "Node16",
    "moduleResolution": "node16",
    
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts"]
}