  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  width: 100%;
  background: var(--haoyu-bg, #0f1117);
  position: relative;
}

.theme-switch {
  position: absolute;
  top: 16px;
  right: 16px;
  z-index: 10;
}

